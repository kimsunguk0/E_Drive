#!/usr/bin/env python
"""⑤-C current-only sparse ScoreDrive 학습 (A0 K=1024, Phase-A softce_exp loss).

배포 forward(=sparse_scoredrive.SparseScoreDrive.forward) 는 건드리지 않는다.
학습용 full-K logits 는 forward_logits 로만 뽑는다(그래프/텐서모양 동일 → latency 불변).

  python train_sparse_scoredrive.py --run pos_s0 --gpu 0 --seed 0
  python train_sparse_scoredrive.py --run aux_s0 --gpu 2 --seed 0 --aux5

체크포인트는 매 --eval-frac epoch 마다 tuneval(30 scene, frame>=30) 에서
selector realized L2(λ0.1) 로 평가해 best 저장. epoch-말 과적합 방지.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time

import numpy as np
import torch
from torch import nn
from torch.utils.data import DataLoader

A = "/NHNHOME/data/sukim/adcl"
sys.path.insert(0, os.path.join(A, "scripts"))
import sparse_common as C  # noqa: E402
from sparse_scoredrive import SparseScoreDrive  # noqa: E402

IMAGENET_R34 = os.path.join(A, "ckpt/backbones/resnet34-b627a593.pth")
IMAGENET_R50 = os.path.join(A, "ckpt/backbones/resnet50-imagenet.pth")
VAD_CKPT = os.path.join(A, "work_dirs/pa2_softceexp/epoch_2.pth")
NUIM_CKPT = os.path.join(
    A, "ckpt/backbones/cascade_mask_rcnn_r50_fpn_coco-20e_20e_nuim_"
       "20201009_124951-40963960.pth")


def load_nuim_backbone(backbone_fpn, path):
    """nuImages(COCO->nuImages) Mask R-CNN R50 의 backbone 을 이식.
    BEVFormer/VAD 계열의 표준 초기값이며 nuScenes 도메인에 가장 가깝다."""
    sd = torch.load(path, map_location="cpu")
    sd = sd.get("state_dict", sd)
    remap = {}
    for k, v in sd.items():
        if not k.startswith("backbone."):
            continue
        kk = k[len("backbone."):]
        if kk.startswith("conv1."):
            remap["stem.0." + kk[len("conv1."):]] = v
        elif kk.startswith("bn1."):
            remap["stem.1." + kk[len("bn1."):]] = v
        elif kk.startswith(("layer1.", "layer2.", "layer3.", "layer4.")):
            remap[kk] = v
    missing, unexpected = backbone_fpn.load_state_dict(remap, strict=False)
    still = [m for m in missing if not m.startswith(("lat", "out"))]
    return dict(injected=len(remap), unexpected=len(unexpected),
                nonhead_missing=still)


def load_vad_backbone(backbone_fpn, path):
    """dense champion 의 img_backbone(ResNet-50) 을 sparse trunk 에 이식.
    img_neck 은 2048->256 단일레벨이라 우리 다중레벨 FPN128 과 맞지 않아 제외한다."""
    sd = torch.load(path, map_location="cpu")
    sd = sd.get("state_dict", sd)
    remap = {}
    for k, v in sd.items():
        if not k.startswith("img_backbone."):
            continue
        kk = k[len("img_backbone."):]
        if kk.startswith("conv1."):
            remap["stem.0." + kk[len("conv1."):]] = v
        elif kk.startswith("bn1."):
            remap["stem.1." + kk[len("bn1."):]] = v
        elif kk.startswith(("layer1.", "layer2.", "layer3.", "layer4.")):
            remap[kk] = v
    missing, unexpected = backbone_fpn.load_state_dict(remap, strict=False)
    still = [m for m in missing if not m.startswith(("lat", "out"))]
    return dict(injected=len(remap), unexpected=len(unexpected),
                nonhead_missing=still)


class TrainableSparseScoreDrive(SparseScoreDrive):
    """배포 forward 는 그대로. 학습용 full-K logits 경로만 추가."""

    def forward_logits(self, images, lidar2img):
        image_hw = (int(images.shape[-2]), int(images.shape[-1]))
        evidence = images.abs().amax(dim=(1, 2, 3, 4)) > 0
        levels, p4 = self.encode_images(images)
        return self.score_features(levels, p4, lidar2img, image_hw, evidence)

    def forward_logits_temporal(self, images, img_hist, lidar2img, hist_T):
        """학습용 full-K temporal logits. 본체는 모델 파일(temporal_logits)에 있다."""
        return self.temporal_logits(images, img_hist, lidar2img, hist_T)


def load_imagenet_resnet34(backbone_fpn, path):
    """ImageNet resnet34 가중을 backbone_fpn(stem/layer1-4)에 주입. lat/out 은 random 유지."""
    sd = torch.load(path, map_location="cpu")
    remap = {}
    for k, v in sd.items():
        if k.startswith("fc."):
            continue
        if k.startswith("conv1."):
            remap["stem.0." + k[len("conv1."):]] = v
        elif k.startswith("bn1."):
            remap["stem.1." + k[len("bn1."):]] = v
        elif k.startswith(("layer1.", "layer2.", "layer3.", "layer4.")):
            remap[k] = v
    missing, unexpected = backbone_fpn.load_state_dict(remap, strict=False)
    inj = len(remap)
    still_missing = [m for m in missing if not m.startswith(
        ("lat", "out"))]  # lat/out 은 의도적으로 random
    return dict(injected=inj, unexpected=len(unexpected),
                nonhead_missing=still_missing)


def set_seed(s):
    np.random.seed(s); torch.manual_seed(s); torch.cuda.manual_seed_all(s)


def apply_freeze(model, stages: int, freeze_bn: bool):
    """설계 §6.2(frozen BN) + §9.2/§9.3(backbone stage1-3 초기 freeze).

    stages=3 -> stem, layer1..layer3 동결. layer4 는 낮은 LR 로 학습.
    freeze_bn -> backbone_fpn 의 모든 BN 을 eval 고정 + affine grad 차단
                 (batch16 에서 BN 통계 요동이 순위 진동의 주원인).
    """
    bf = model.backbone_fpn
    frozen = []
    if stages >= 1:
        frozen.append(("stem", bf.stem))
        for i in range(1, min(stages, 4) + 1):
            frozen.append((f"layer{i}", getattr(bf, f"layer{i}")))
    for _, m in frozen:
        for p in m.parameters():
            p.requires_grad_(False)
    n_bn = 0
    if freeze_bn:
        for m in bf.modules():
            if isinstance(m, nn.BatchNorm2d):
                m.eval()
                n_bn += 1
                for p in m.parameters():
                    p.requires_grad_(False)
    return dict(frozen=[n for n, _ in frozen], n_bn_frozen=n_bn)


def set_train_mode(model, freeze_bn: bool):
    """model.train() 은 BN 을 다시 train 으로 돌리므로 매번 재고정해야 한다."""
    model.train()
    if freeze_bn:
        for m in model.backbone_fpn.modules():
            if isinstance(m, nn.BatchNorm2d):
                m.eval()


def build_loss_buffers(model, device):
    cw3 = torch.tensor(C.CW3, dtype=torch.float32, device=device)
    cw5 = torch.tensor(C.CW5, dtype=torch.float32, device=device)
    anchors_abs = model.candidate_abs[:, :6].to(device)   # [K,6,2] first6=anchor
    cand_abs5 = model.candidate_abs.to(device)            # [K,10,2]
    return cw3, cw5, anchors_abs, cand_abs5


def evaluate_tuneval(model, arr, tune_rows, lidar2img_t, tgt, device, batch,
                     n_hist=0, hist_scale=1.0):
    logits = C.run_logits(model, arr, tune_rows, lidar2img_t, device,
                          batch=batch, amp=True, num_workers=3,
                          n_hist=n_hist, hist_scale=hist_scale)
    rep = C.eval_logits(logits, tgt["D3gt"], tgt["goal_xy"], tgt["cand_end5"],
                        tgt["anchor_dist"], tgt["nms_tau"], tgt["weight"],
                        buckets=tgt["buckets"])
    return rep, logits


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--run", required=True)
    ap.add_argument("--gpu", type=int, default=0)
    ap.add_argument("--seed", type=int, default=0)
    ap.add_argument("--aux5", action="store_true", help="3초 + 약한 5초 aux L_exp(D5)")
    ap.add_argument("--beta5", type=float, default=0.1)
    ap.add_argument("--epochs", type=int, default=8)
    ap.add_argument("--batch", type=int, default=16)
    ap.add_argument("--lr", type=float, default=2e-4, help="scorer head LR (§9.3)")
    ap.add_argument("--fpn-lr", type=float, default=2e-4,
                    help="FPN lat/out LR (random init 이라 §9.3 의 2e-5 보다 높게)")
    ap.add_argument("--backbone-lr", type=float, default=1e-4,
                    help="backbone layer4 LR (§9.3)")
    ap.add_argument("--freeze-stages", type=int, default=0,
                    help="stem+layer1..N 동결 (§9.2/§9.3, 0=전체 학습)")
    ap.add_argument("--freeze-bn", type=int, default=0,
                    help="⚠️ 1 은 ⑤-C/C3 에서 3회 학습 붕괴. 0 유지.")
    ap.add_argument("--logit-norm", type=int, default=1,
                    help="코사인+학습온도로 logit scale 유계화 (포화/NaN 방지)")
    ap.add_argument("--amp-dtype", default="bf16", choices=["bf16", "fp16"])
    ap.add_argument("--feature-norm", type=int, default=0,
                    help="sampled/scene LayerNorm (frozen-BN 발산 방지, 파라미터 0개)")
    ap.add_argument("--max-iters", type=int, default=0, help="0=off, 짧은 진단용")
    ap.add_argument("--objective", default="softce_exp", choices=["softce_exp", "set"])
    ap.add_argument("--set-k", type=int, default=16)
    ap.add_argument("--w-exp-set", type=float, default=0.1)
    ap.add_argument("--alpha-kd", type=float, default=0.0)
    ap.add_argument("--teacher", default="", help="teacher logits npz (row->logits)")
    ap.add_argument("--tau-kd", type=float, default=1.0)
    ap.add_argument("--arch", default="resnet34", choices=["resnet34", "resnet50"])
    ap.add_argument("--init", default="imagenet", choices=["imagenet", "vad", "nuim", "none"],
                    help="vad = dense champion img_backbone 이식 (resnet50 전용)")
    ap.add_argument("--w-occ", type=float, default=0.0, help="보조 점유 supervision 가중")
    ap.add_argument("--w-rank", type=float, default=1.0,
                    help="0 = occ-only (점유 학습 상한 진단)")
    ap.add_argument("--offset-sample", type=int, default=0, help="설계 §6.3 4-offset 표본")
    ap.add_argument("--use-p1", type=int, default=0, help="stride 4 FPN 레벨 추가")
    ap.add_argument("--corridor", default="0",
                    help="경로 법선 방향 지면 오프셋(m), 콤마구분. 예 '0,0.75,-0.75,1.5,-1.5'")
    ap.add_argument("--seq-head", default="none", choices=["none", "tcn"],
                    help="waypoint 순서/곡률을 읽는 sequence head")
    ap.add_argument("--n-hist", type=int, default=0, help="⑤-D 과거 프레임 수")
    ap.add_argument("--probe-a-n", type=int, default=810,
                    help="probe A 표본 수(진단용이라 B 보다 작게)")
    ap.add_argument("--hist-scale", type=float, default=1.0)
    # merged(현재+과거 한 batch, BN 통계 공유) 는 ⑤-D 에서 학습이 발산했다.
    # split 만 안정적이므로 기본 0.
    ap.add_argument("--merge-encode", type=int, default=0)
    ap.add_argument("--fuse-mul", type=int, default=1)
    ap.add_argument("--agent-labels",
                    default=os.path.join(A, "data/etri/agent_labels_train.npz"))
    ap.add_argument("--kd-mode", default="full",
                    choices=["full", "top64", "shortlist"])
    ap.add_argument("--kd-topk", type=int, default=64)
    ap.add_argument("--init-from", default="", help="학습된 student ckpt 에서 시작")
    ap.add_argument("--w-speed", type=float, default=0.0,
                    help="진행량 회귀 보조 가중 (설계 §4.5 라벨)")
    ap.add_argument("--speed-gamma", type=float, default=0.0,
                    help="logit 진행량 감점 계수 초기값(학습가능). 0=보조회귀만")
    ap.add_argument("--freeze-trunk", type=int, default=0,
                    help="1=backbone+FPN 동결, scorer 만 학습 (⑤-E1)")
    ap.add_argument("--kd-min-frame", type=int, default=30,
                    help="teacher 신뢰 구간: 이 frame 이상만 KD 적용")
    ap.add_argument("--bucket-sample", type=int, default=1,
                    help="1=0.5초 구간당 1프레임, 시나리오 round-robin batch")
    ap.add_argument("--aug", type=int, default=1, help="photometric aug")
    ap.add_argument("--cam-dropout", type=float, default=0.1)
    ap.add_argument("--holdout-offset", type=int, default=1,
                    help="frame%%5==4 를 학습 제외(암기 probe A)")
    ap.add_argument("--all-frames", type=int, default=1,
                    help="1=학습 scene 10Hz 전체 프레임(90k), 0=2Hz main만(18k)")
    ap.add_argument("--wd", type=float, default=1e-2)
    ap.add_argument("--eval-frac", type=float, default=0.25)
    # 기본값 = ⑤-C2 에서 검증된 설정. freeze/저LR 조합은 실패 확정이므로
    # 기본값으로 두지 않는다(플래그 누락 시 실패 설정 재현 방지).
    ap.add_argument("--warmup", type=int, default=125)
    ap.add_argument("--workers", type=int, default=8)
    ap.add_argument("--workdir", default=os.path.join(A, "work_dirs"))
    args = ap.parse_args()

    device = torch.device(f"cuda:{args.gpu}")
    torch.cuda.set_device(device)
    set_seed(args.seed)
    torch.backends.cudnn.benchmark = True

    wd = os.path.join(args.workdir, f"sc_{args.run}")
    os.makedirs(wd, exist_ok=True)
    log = open(os.path.join(wd, "train.log"), "a", buffering=1)

    def P(*a):
        msg = " ".join(str(x) for x in a)
        print(msg, flush=True); log.write(msg + "\n")

    P(f"=== ⑤-C run={args.run} gpu={args.gpu} seed={args.seed} "
      f"aux5={args.aux5} beta5={args.beta5} ===")
    P(f"epochs={args.epochs} batch={args.batch} lr={args.lr} "
      f"backbone_lr={args.backbone_lr} fpn_lr={args.fpn_lr} "
      f"freeze_stages={args.freeze_stages} freeze_bn={args.freeze_bn} "
      f"feature_norm={args.feature_norm} logit_norm={args.logit_norm} "
      f"amp={args.amp_dtype} eval_frac={args.eval_frac}")

    arr = C.load_arrays()
    split = C.make_split(arr, all_frames=bool(args.all_frames),
                         holdout_offset=bool(args.holdout_offset))
    train_rows, tune_rows = split["train_rows"], split["tune_rows"]
    probe_all = split["probe_rows"]
    if args.n_hist:
        # ⑤-D: 과거 n_hist 장이 같은 시나리오 안에 있어야 한다
        train_rows = train_rows[C.history_available(arr, train_rows, args.n_hist)]
        tune_rows = tune_rows[C.history_available(arr, tune_rows, args.n_hist)]
        probe_all = probe_all[C.history_available(arr, probe_all, args.n_hist)]
    split["probe_rows"] = probe_all
    P(f"train rows {len(train_rows)} (300 scene, all_frames={args.all_frames}) | tuneval rows {len(tune_rows)} "
      f"(30 scene, frame>=30) | tune scenes[:3]={split['tune_scenes'][:3]}")

    l2i = C.build_global_lidar2img()
    lidar2img_t = torch.from_numpy(l2i)
    P(f"lidar2img built {l2i.shape}")

    bank = np.load(C.BANK_A0, allow_pickle=False)
    model = TrainableSparseScoreDrive(
        C.BANK_A0, feature_norm=bool(args.feature_norm),
        logit_norm=bool(args.logit_norm), arch=args.arch,
        occ_aux=(args.w_occ > 0.0),
        offset_sample=bool(args.offset_sample),
        use_p1=bool(args.use_p1), n_hist=args.n_hist,
        corridor=tuple(float(x) for x in str(args.corridor).split(",") if x != ""),
        seq_head=args.seq_head,
        speed_head=(args.w_speed > 0.0),
        speed_gamma=args.speed_gamma).to(device)
    model.merge_encode = bool(args.merge_encode)
    model.fuse_mul = bool(args.fuse_mul)
    if args.init == "vad":
        inj = load_vad_backbone(model.backbone_fpn, VAD_CKPT)
    elif args.init == "nuim":
        inj = load_nuim_backbone(model.backbone_fpn, NUIM_CKPT)
    elif args.init == "imagenet":
        inj = load_imagenet_resnet34(
            model.backbone_fpn,
            IMAGENET_R50 if args.arch == "resnet50" else IMAGENET_R34)
    else:
        inj = dict(injected=0, nonhead_missing=[])
    P(f"arch={args.arch} init={args.init} injected={inj['injected']} "
      f"nonhead_missing={inj['nonhead_missing'][:4]}")
    n_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
    P(f"trainable params {n_params:,}")

    cw3, cw5, anchors_abs, cand_abs5 = build_loss_buffers(model, device)
    teacher_map = None
    if args.teacher and os.path.isfile(args.teacher):
        tz = np.load(args.teacher, allow_pickle=False)
        teacher_map = {int(r): i for i, r in enumerate(tz["rows"])}
        teacher_logits = tz["logits"].astype(np.float32)
        P(f"teacher logits {teacher_logits.shape} rows={len(teacher_map)} "
          f"alpha_kd={args.alpha_kd}")
    agent_map = None
    if args.w_occ > 0.0 and os.path.isfile(args.agent_labels):
        az = np.load(args.agent_labels, allow_pickle=False)
        agent_map = {int(r): i for i, r in enumerate(az["rows"])}
        ag_pos = az["pos"].astype(np.float32)
        ag_rad = az["rad"].astype(np.float32)
        ag_msk = az["mask"]
        P(f"agent labels {ag_pos.shape} rows={len(agent_map)} w_occ={args.w_occ}")
    cand6 = model.candidate_abs[:, :6].to(device)
    loss_fn = C.ScoreDriveLoss(aux5=args.aux5, beta5=args.beta5,
                               objective=args.objective, set_k=args.set_k,
                               w_exp_set=args.w_exp_set,
                               alpha_kd=args.alpha_kd, tau_kd=args.tau_kd,
                               w_occ=args.w_occ, w_rank=args.w_rank,
                               kd_mode=args.kd_mode, w_speed=args.w_speed)
    P(f"offset_sample={args.offset_sample} use_p1={args.use_p1} "
      f"w_occ={args.w_occ} w_rank={args.w_rank} "
      f"n_hist={args.n_hist} hist_scale={args.hist_scale} "
      f"w_speed={args.w_speed} speed_gamma={args.speed_gamma} "
      f"merge_encode={args.merge_encode}")
    P(f"objective={args.objective} set_k={args.set_k} w_exp_set={args.w_exp_set} "
      f"alpha_kd={args.alpha_kd} bucket_sample={args.bucket_sample} "
      f"aug={args.aug} cam_dropout={args.cam_dropout}")

    probe_rows = split["probe_rows"]
    if len(probe_rows) > args.probe_a_n:
        probe_rows = probe_rows[
            np.linspace(0, len(probe_rows) - 1, args.probe_a_n).astype(int)]
    tgt = C.precompute_targets(arr, tune_rows, bank)     # probe B: 미학습 시나리오
    tgtA = C.precompute_targets(arr, probe_rows, bank)   # probe A: 학습 시나리오·미학습 offset
    P(f"probe A(same-scene unseen frame%5==4) n={len(probe_rows)} | "
      f"probe B(tuneval, new scenario) n={len(tune_rows)}")

    if args.init_from:
        _ck = torch.load(args.init_from, map_location="cpu")
        _miss, _unx = model.load_state_dict(_ck["model"], strict=False)
        P(f"init_from={args.init_from} missing={len(_miss)} unexpected={len(_unx)}")
    if args.freeze_trunk:
        # ⑤-E1: 동일 trunk 를 고정하고 ranker 만 비교(Phase A frozen-trunk tournament)
        for p_ in model.backbone_fpn.parameters():
            p_.requires_grad_(False)
        n_tr = sum(p_.numel() for p_ in model.parameters() if p_.requires_grad)
        P(f"freeze_trunk: backbone+FPN 동결, scorer 학습가능 {n_tr:,}")
    fz = apply_freeze(model, args.freeze_stages, bool(args.freeze_bn))
    P(f"freeze: stages={fz['frozen']} BN_frozen={fz['n_bn_frozen']}")

    # optimizer param groups (설계 §9.3): head > FPN > backbone(layer4)
    bb_params, fpn_params, head_params = [], [], []
    for name, p in model.named_parameters():
        if not p.requires_grad:
            continue
        if name.startswith("backbone_fpn.lat") or name.startswith("backbone_fpn.out"):
            fpn_params.append(p)
        elif name.startswith("backbone_fpn."):
            bb_params.append(p)
        else:
            head_params.append(p)
    opt = torch.optim.AdamW(
        [dict(params=bb_params, lr=args.backbone_lr),
         dict(params=fpn_params, lr=args.fpn_lr),
         dict(params=head_params, lr=args.lr)], weight_decay=args.wd)
    n_train = sum(p.numel() for p in bb_params + fpn_params + head_params)
    P(f"param groups: backbone {sum(p.numel() for p in bb_params):,} "
      f"@{args.backbone_lr:.0e} | fpn {sum(p.numel() for p in fpn_params):,} "
      f"@{args.fpn_lr:.0e} | head {sum(p.numel() for p in head_params):,} "
      f"@{args.lr:.0e} | total trainable {n_train:,}")

    def make_loader(ep):
        if args.bucket_sample:
            rows = C.make_epoch_rows(arr, train_rows, seed=args.seed * 1000 + ep)
            shuf = False
        else:
            rows, shuf = train_rows, True
        ds = C.SparseFrameDataset(arr, rows, aug=bool(args.aug),
                                  cam_dropout=args.cam_dropout, epoch=ep,
                                  n_hist=args.n_hist,
                                  hist_scale=args.hist_scale)
        return DataLoader(ds, batch_size=args.batch, shuffle=shuf,
                          num_workers=args.workers, pin_memory=True,
                          drop_last=True)
    dl0 = make_loader(0)
    iters_per_epoch = len(dl0)
    total_iters = iters_per_epoch * args.epochs
    warmup = min(args.warmup, total_iters // 10)
    sched = torch.optim.lr_scheduler.SequentialLR(
        opt, [torch.optim.lr_scheduler.LinearLR(
                  opt, start_factor=0.05, total_iters=warmup),
              torch.optim.lr_scheduler.CosineAnnealingLR(
                  opt, T_max=max(1, total_iters - warmup))],
        milestones=[warmup])
    amp_dt = torch.bfloat16 if args.amp_dtype == "bf16" else torch.float16
    # bf16 은 동적범위가 넓어 GradScaler 가 불필요하다(fp16 오버플로우 회피).
    scaler = torch.cuda.amp.GradScaler(enabled=(args.amp_dtype == "fp16"))
    eval_every = max(1, int(iters_per_epoch * args.eval_frac))
    P(f"iters/epoch {iters_per_epoch} total {total_iters} eval_every {eval_every}")

    lidar2img_dev = lidar2img_t.to(device)
    best = dict(realized=1e9, step=-1)
    hist = []
    step = 0
    t0 = time.time()
    for ep in range(args.epochs):
        dl = dl0 if ep == 0 else make_loader(ep)
        set_train_mode(model, bool(args.freeze_bn))
        run_loss = 0.0; nb = 0
        for b in dl:
            img = b["img"].to(device, non_blocking=True)
            gt3 = b["gt3"].to(device, non_blocking=True)
            l2ib = lidar2img_dev.unsqueeze(0).expand(img.shape[0], -1, -1, -1)
            D3 = C.metric_d3(gt3, anchors_abs, cw3)
            D5 = None
            if args.aux5:
                gt5 = b["gt5"].to(device, non_blocking=True)
                m5 = b["mask5"].to(device, non_blocking=True)
                D5 = C.metric_d5(gt5, m5, cand_abs5, cw5)
            opt.zero_grad(set_to_none=True)
            with torch.autocast(device_type="cuda", dtype=amp_dt):
                if args.n_hist:
                    logits = model.forward_logits_temporal(
                        img, b["img_hist"].to(device, non_blocking=True), l2ib,
                        b["hist_T"].to(device, non_blocking=True))
                else:
                    logits = model.forward_logits(img, l2ib)
            tb = kdm = None
            if teacher_map is not None and args.alpha_kd > 0.0:
                rws = np.asarray(b["row"].tolist(), np.int64)
                idx = np.array([teacher_map.get(int(r), -1) for r in rws])
                ok = (idx >= 0) & (arr["frame"][rws] >= args.kd_min_frame)
                if ok.any():
                    tb = torch.from_numpy(
                        teacher_logits[np.clip(idx, 0, None)]).to(device)
                    kdm = torch.from_numpy(ok.astype(np.float32)).to(device)
            occ_lab = None
            if agent_map is not None:
                rws2 = np.asarray(b["row"].tolist(), np.int64)
                ai = np.array([agent_map.get(int(r), -1) for r in rws2])
                if (ai >= 0).all():
                    ap = torch.from_numpy(ag_pos[ai]).to(device)
                    ar = torch.from_numpy(ag_rad[ai]).to(device)
                    am = torch.from_numpy(ag_msk[ai]).to(device)
                    occ_lab = C.occupancy_labels(cand6, ap, ar, am)
            kd_idx = None
            if tb is not None:
                if args.kd_mode == "top64":
                    kd_idx = tb.topk(min(args.kd_topk, tb.shape[-1]), dim=-1).indices
                elif args.kd_mode == "shortlist":
                    kd_idx = model._stable_score3_nms9(tb)
            sp_lab = None
            if args.w_speed > 0.0:
                gt5b = b["gt5"].to(device, non_blocking=True)
                sp_lab = C.progress_labels(gt3, gt5b)
            loss, comp = loss_fn(logits, D3, D5, teacher=tb, kd_mask=kdm,
                                 occ_logits=model._occ_logits, occ_lab=occ_lab,
                                 kd_idx=kd_idx, speed_pred=model._speed_pred,
                                 speed_lab=sp_lab)
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            gn = torch.nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            scaler.step(opt); scaler.update(); sched.step()
            run_loss += float(loss); nb += 1; step += 1
            if args.max_iters and step >= args.max_iters:
                break

            if step % eval_every == 0:
                rep, _ = evaluate_tuneval(model, arr, tune_rows, lidar2img_t,
                                          tgt, device, args.batch,
                                          args.n_hist, args.hist_scale)
                repA, _ = evaluate_tuneval(model, arr, probe_rows, lidar2img_t,
                                           tgtA, device, args.batch,
                                           args.n_hist, args.hist_scale)
                set_train_mode(model, bool(args.freeze_bn))
                r10 = rep["realized"]["0.1"]
                el = time.time() - t0
                cs = " ".join(f"{k}={float(v):.3f}" for k, v in comp.items())
                P(f"[ep{ep} it{step}/{total_iters} {el/60:.1f}m] "
                  f"loss={run_loss/nb:.4f} {cs} gn={float(gn):.2f} "
                  f"lr={sched.get_last_lr()[2]:.2e} || A(seen-scene) "
                  f"slO@12={repA['shortlist_oracle12']:.4f} "
                  f"real={repA['realized']['0.1']:.4f} || B(new-scene) "
                  f"top1={rep['top1']:.4f} slO@12={rep['shortlist_oracle12']:.4f} "
                  f"real={r10:.4f}")
                hist.append(dict(step=step, ep=ep, loss=run_loss/nb,
                                 top1=rep["top1"], oracle12=rep["oracle12"],
                                 slO12=rep["shortlist_oracle12"],
                                 realized=rep["realized"],
                                 probeA_slO12=repA["shortlist_oracle12"],
                                 probeA_real=repA["realized"]["0.1"],
                                 probeA_top1=repA["top1"]))
                run_loss = 0.0; nb = 0
                sel = rep["shortlist_oracle12"]   # gate 1순위 = slO@12
                if sel < best["realized"]:
                    best = dict(realized=sel, step=step, ep=ep, report=rep,
                                realized_l2=r10, probeA=repA)
                    torch.save(dict(model=model.state_dict(), step=step, ep=ep,
                                    report=rep, args=vars(args)),
                               os.path.join(wd, "best.pth"))
                    P(f"    * new best slO@12={sel:.4f} (real={r10:.4f}) @ step {step}")
        torch.save(dict(model=model.state_dict(), step=step, ep=ep,
                        args=vars(args)), os.path.join(wd, "last.pth"))
        if args.max_iters and step >= args.max_iters:
            break

    P(f"=== DONE run={args.run} best slO@12={best['realized']:.4f} "
      f"@ ep{best.get('ep')} step{best['step']} ===")
    json.dump(dict(run=args.run, seed=args.seed, aux5=args.aux5,
                   best=dict(realized=best["realized"], step=best["step"],
                             ep=best.get("ep"), report=best.get("report")),
                   history=hist),
              open(os.path.join(wd, "history.json"), "w"), indent=1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
